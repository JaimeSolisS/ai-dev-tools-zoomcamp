# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-random-secret-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Host is `localhost` when running Django directly on the host (bare metal).
# Under Docker Compose, Django runs in the `web` container and must reach
# Postgres via the `db` service name instead — change this line to:
#   DATABASE_URL=postgres://retroloop:retroloop@db:5432/retroloop
# See README.md for the full docker compose quick start.
DATABASE_URL=postgres://retroloop:retroloop@localhost:5432/retroloop

# Only read by the `db` service in compose.yaml (ignored when running
# Django on bare metal against a self-managed Postgres). These must stay in
# sync with the user/password/database embedded in DATABASE_URL above --
# compose.yaml deliberately has no hardcoded fallback for them.
POSTGRES_USER=retroloop
POSTGRES_PASSWORD=retroloop
POSTGRES_DB=retroloop
