# Which backend implementation the services layer uses: "http" (default, the real backend) or "mock".
VITE_BACKEND=http
# Simulated network latency for the mock backend (VITE_BACKEND=mock), in milliseconds.
VITE_MOCK_LATENCY_MS=120
# Base URL for the real backend (used when VITE_BACKEND=http).
VITE_API_BASE_URL=http://localhost:8091
